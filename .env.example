# Frontend em producao: endereco acessivel pelo servidor, nunca pelo navegador.
# No Easypanel, normalmente use o nome interno do servico de renderizacao.
RENDER_API_INTERNAL_URL=http://editor-video-backend:3001

# Backend de renderizacao
RENDER_HOST=0.0.0.0
RENDER_PORT=3001
FRONTEND_ORIGIN=http://localhost:8080
RENDER_RESULT_TTL_HOURS=24
# Em producao, aponte para um volume persistente.
# RENDER_DATA_DIR=/app/data/render-jobs
# FFMPEG_PATH=C:\caminho\para\ffmpeg.exe

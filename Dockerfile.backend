FROM node:20-bookworm-slim AS builder

ARG GIT_SHA=unknown

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY backend ./backend
# O backend reutiliza modulos compartilhados em src/lib. Copiar todo o src
# garante que imports do bundle existam no builder; apenas dist vai para a imagem final.
COPY src ./src
RUN grep -q '"/api/render/drive-progress"' src/server/node-handler.ts \
  && grep -q '\["image", "video", "narration", "music"\]' src/server/render-service.ts \
  && echo "Building backend revision ${GIT_SHA}" \
  && npm run build:backend \
  && grep -q '/api/render/drive-progress' dist/render-backend.mjs \
  && grep -q 'video-' dist/render-backend.mjs \
  && printf '%s\n' "${GIT_SHA}" > /app/BUILD_SHA

FROM node:20-bookworm-slim AS runner

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision="${GIT_SHA}"

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/BUILD_SHA ./BUILD_SHA

ENV NODE_ENV=production
ENV RENDER_HOST=0.0.0.0
ENV RENDER_PORT=3001
ENV RENDER_DATA_DIR=/app/data/render-jobs
ENV RENDER_RESULT_TTL_HOURS=24
EXPOSE 3001

CMD ["node", "dist/render-backend.mjs"]

# Frontend: deixe vazio em desenvolvimento para usar o proxy do Vite.
# No Easypanel, informe a URL publica do servico backend antes do build.
VITE_RENDER_API_URL=

# Backend de renderizacao
RENDER_HOST=0.0.0.0
RENDER_PORT=3001
FRONTEND_ORIGIN=http://localhost:8080
RENDER_RESULT_TTL_HOURS=24
# Em producao, aponte para um volume persistente.
# RENDER_DATA_DIR=/app/data/render-jobs
# FFMPEG_PATH=C:\caminho\para\ffmpeg.exe
